
# Beads / Dolt files (added by bd init)
.dolt/
*.db
# Журнал и разделяемая память SQLite: те же данные, что и в базе.
*.db-shm
*.db-wal
.beads-credential-key
.beads/proxieddb/

# Rust
/target/
**/*.rs.bk

# Nix
result
result-*

# direnv
.direnv/

# cargo-mutants: прямой запуск без --output оставляет отчёты в корне
mutants.out/
mutants.out.old/

# Кэш интерпретатора: генератор фикстур импортируется тестами задачи 9.
__pycache__/

# Отчёт покрытия: артефакт `make coverage`, а не исходник.
lcov.info

# Subagent worktrees created by the agent harness inside the checkout.
.claude/worktrees/

# --- repowise (local codebase index) ---
# The index regenerates from the tree, so it is per-clone and never shared.
# .repowise/.env holds the provider key. .claude/CLAUDE.md and .mcp.json are
# repowise's generated agent wiring: kept local, so repowise stays opt-in per
# clone instead of being committed to everyone. The hand-written CLAUDE.md and
# AGENTS.md at the root are ours and repowise is told not to touch them.
.repowise/
.claude/CLAUDE.md
.mcp.json
# repowise also writes these; mcp.json embeds this machine's absolute path.
.vscode/mcp.json
.vscode/extensions.json
# repowise's auto-sync post-commit hook. core.hooksPath is .beads/hooks, which
# is TRACKED and regenerated by beads, so the hook lands in a shared directory;
# ignoring it keeps repowise opt-in per clone. The other five hooks there are
# beads' own and stay tracked.
.beads/hooks/post-commit

# repowise API keys (local)
.repowise/.env
